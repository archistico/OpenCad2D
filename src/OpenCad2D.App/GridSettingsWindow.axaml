<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gridvm="clr-namespace:OpenCad2D.App.ViewModels.Grid"
        x:Class="OpenCad2D.App.GridSettingsWindow"
        x:DataType="gridvm:GridSettingsWindowViewModel"
        Title="Grid Settings"
        Icon="/Assets/app-icon.ico"
        Width="520"
        Height="560"
        MinWidth="480"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="Foreground" Value="#9CDCFE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style Selector="ComboBox.input">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="5,2" />
        </Style>

        <Style Selector="CheckBox.input-check">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Button.dialog-button">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,4" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="12">

        <StackPanel Grid.Row="0"
                    Spacing="3">
            <TextBlock Text="Grid"
                       Foreground="#FFFFFF"
                       FontSize="16"
                       FontWeight="Bold" />
            <TextBlock Text="Configure grid visibility, spacing, origin and layout type. Grid snap is still enabled or disabled from the Snap bar."
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="7">
                <TextBlock Classes="section-title" Text="General" />

                <CheckBox Classes="input-check"
                          Content="Show grid"
                          IsChecked="{Binding IsVisible}" />

                <Grid ColumnDefinitions="135,*"
                      RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="7">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Type" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              Classes="input"
                              ItemsSource="{Binding GridKinds}"
                              SelectedItem="{Binding SelectedGridKind}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Minor step" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Classes="input"
                             Text="{Binding MinorStep}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Major step" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Classes="input"
                             Text="{Binding MajorStep}" />
                </Grid>

                <TextBlock Classes="section-title" Text="Origin" />

                <Grid ColumnDefinitions="135,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="7">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Origin X" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Classes="input"
                             Text="{Binding OriginX}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Origin Y" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Classes="input"
                             Text="{Binding OriginY}" />
                </Grid>

                <TextBlock Classes="section-title" Text="Rendering" />

                <Grid ColumnDefinitions="135,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="7">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Min screen spacing" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Classes="input"
                             Text="{Binding MinimumScreenSpacing}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Max screen spacing" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Classes="input"
                             Text="{Binding MaximumScreenSpacing}" />
                </Grid>

                <TextBlock Classes="section-title" Text="Isometric" />

                <Grid ColumnDefinitions="135,*"
                      RowDefinitions="Auto"
                      RowSpacing="7">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Diagonal angle" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Classes="input"
                             Text="{Binding IsometricAngleDegrees}" />
                </Grid>

                <TextBlock Text="Default isometric grid uses vertical lines plus two diagonal families at +30° and -30°."
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Text="{Binding ValidationMessage}"
                   Foreground="#F48771"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="7"
                    Margin="0,10,0,0">
            <Button Classes="dialog-button"
                    Content="Cancel"
                    Click="Cancel_Click" />
            <Button Classes="dialog-button"
                    Content="OK"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
