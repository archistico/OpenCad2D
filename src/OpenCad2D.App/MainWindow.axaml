<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCad2D.App.Controls"
        xmlns:vm="clr-namespace:OpenCad2D.App.ViewModels"
        x:Class="OpenCad2D.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OpenCad2D"
        Width="1200"
        Height="760"
        Background="#1E1E1E">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Toolbar -->
		<Border Grid.Row="0"
                Background="#252526"
                Padding="8">

			<StackPanel Orientation="Vertical"
                        Spacing="6">

				<StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Spacing="6"
            Margin="8">

					<Button Content="Select"
							Click="Select_Click" />

					<Button Content="Line"
							Click="Line_Click" />

					<Button Content="Rectangle"
							Click="Rectangle_Click" />

					<Button Content="Move"
							Click="Move_Click" />

					<Button Content="Copy"
							Click="Copy_Click" />

					<Button Content="Delete"
							Click="Delete_Click" />

					<Button Content="Undo"
							Click="Undo_Click" />

					<Button Content="Redo"
							Click="Redo_Click" />

					<Separator Margin="8,0" />

					<TextBlock Text="Layer:"
						VerticalAlignment="Center"
						Margin="4,0,6,0" />

					<ComboBox x:Name="LayerComboBox"
							  Width="150"
							  SelectionChanged="LayerComboBox_SelectionChanged" />

					<Separator Margin="8,0" />

					<!-- Qui tieni le tue CheckBox degli snap -->
				</StackPanel>

				<StackPanel Orientation="Horizontal"
            Spacing="10">

					<TextBlock Text="Snap:"
							   Foreground="#CCCCCC"
							   VerticalAlignment="Center"
							   FontWeight="Bold" />

					<CheckBox x:Name="SnapEndpointCheckBox"
							  Content="Endpoint"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapEndpoint_Changed" />

					<CheckBox x:Name="SnapMidpointCheckBox"
							  Content="Midpoint"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapMidpoint_Changed" />

					<CheckBox x:Name="SnapCenterCheckBox"
							  Content="Center"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapCenter_Changed" />

					<CheckBox x:Name="SnapQuadrantCheckBox"
							  Content="Quadrant"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapQuadrant_Changed" />

					<CheckBox x:Name="SnapIntersectionCheckBox"
							  Content="Intersection"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapIntersection_Changed" />

					<CheckBox x:Name="SnapPerpendicularCheckBox"
							  Content="Perpendicular"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapPerpendicular_Changed" />

					<CheckBox x:Name="SnapTangentCheckBox"
							  Content="Tangent"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapTangent_Changed" />

					<CheckBox x:Name="SnapGridCheckBox"
							  Content="Grid"
							  Foreground="#CCCCCC"
							  IsChecked="True"
							  Click="SnapGrid_Changed" />

				</StackPanel>

			</StackPanel>
		</Border>

		<!-- Canvas CAD -->
		<controls:CadCanvas Grid.Row="1"
                            x:Name="CadCanvas"
                            Workspace="{Binding Workspace}"
                            WorkspaceChanged="CadCanvas_WorkspaceChanged" />

		<!-- Status bar -->
		<Border Grid.Row="2"
                Background="#111111"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="8,5"
                MinHeight="28">

			<TextBlock x:Name="StatusTextBlock"
                       Text="Ready."
                       Foreground="#E0E0E0"
                       FontFamily="Consolas"
                       FontSize="12"
                       VerticalAlignment="Center" />
		</Border>

	</Grid>
</Window>