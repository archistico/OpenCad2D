<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCad2D.App.Controls"
        xmlns:vm="clr-namespace:OpenCad2D.App.ViewModels"
        xmlns:props="clr-namespace:OpenCad2D.App.ViewModels.Properties"
        x:Class="OpenCad2D.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OpenCad2D"
        Width="1600"
        Height="960"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown"
        TextInput="Window_TextInput">

    <Window.Styles>
        <Style Selector="Button.tool-button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="92" />
        </Style>

        <Style Selector="Button.tool-button.active-tool">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33A9FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Button.global-button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="72" />
        </Style>

        <Style Selector="TextBlock.active-command-label">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.panel-section-label">
            <Setter Property="Foreground" Value="#9CDCFE" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>

        <Style Selector="CheckBox.snap-check">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="CheckBox.layer-check">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <Style Selector="Border.property-panel">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <Style Selector="TextBlock.property-panel-title">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.property-section-title">
            <Setter Property="Foreground" Value="#9CDCFE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style Selector="TextBlock.property-name">
            <Setter Property="Foreground" Value="#AFAFAF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock.property-value">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">


        <!-- File command bar: keep document commands isolated from tool layout. -->
        <Border Grid.Row="0"
                Background="#1B1B1B"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="8,6">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="8">

                    <TextBlock Text="File:"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />

                    <Button Classes="global-button"
                            Content="New"
                            Click="New_Click" />

                    <Button Classes="global-button"
                            Content="Open"
                            Click="Open_Click" />

                    <Button Classes="global-button"
                            Content="Save"
                            Click="Save_Click" />

                    <Button Classes="global-button"
                            Content="Save As"
                            Click="SaveAs_Click" />

                    <Separator Margin="8,0" />

                    <Button Classes="global-button"
                            Content="Export SVG"
                            Click="ExportSvg_Click" />

                    <Separator Margin="8,0" />

                    <TextBlock Text="{Binding FileStatusText}"
                               Foreground="#DCDCAA"
                               VerticalAlignment="Center"
                               FontFamily="Consolas" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top bar: session/global state -->
        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="8">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="8">

                    <TextBlock Text="Layer:"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />

                    <ComboBox x:Name="LayerComboBox"
                              Width="150"
                              SelectionChanged="LayerComboBox_SelectionChanged" />

                    <CheckBox x:Name="LayerVisibleCheckBox"
                              Classes="layer-check"
                              Content="Visible"
                              IsChecked="True"
                              IsEnabled="False"
                              Click="LayerVisibleCheckBox_Click" />

                    <CheckBox x:Name="LayerLockedCheckBox"
                              Classes="layer-check"
                              Content="Locked"
                              IsChecked="False"
                              IsEnabled="False"
                              Click="LayerLockedCheckBox_Click" />

                    <Button Classes="global-button"
                            Content="Layers..."
                            Click="Layers_Click" />

                    <Button Classes="global-button"
                            Content="Line formats..."
                            Click="LineFormats_Click" />

                    <Button Classes="global-button"
                            Content="Grid..."
                            Click="Grid_Click" />

                    <Separator Margin="8,0" />

                    <TextBlock Text="Polar:"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />

                    <ComboBox x:Name="PolarTrackingComboBox"
                              Width="88"
                              SelectionChanged="PolarTrackingComboBox_SelectionChanged" />

                    <Separator Margin="8,0" />

                    <Button Classes="global-button"
                            Content="Undo"
                            Click="Undo_Click" />

                    <Button Classes="global-button"
                            Content="Redo"
                            Click="Redo_Click" />

                    <Button Classes="global-button"
                            Content="Extents"
                            Click="ZoomExtents_Click" />

                    <Button x:Name="PropertiesButton"
                            Classes="global-button"
                            Content="Props"
                            Click="Properties_Click" />

                    <Separator Margin="8,0" />

                    <TextBlock x:Name="ActiveCommandTextBlock"
                               Classes="active-command-label"
                               Text="{Binding ActiveToolName}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main work area -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ClipToBounds="True">

            <!-- Left tool panel -->
            <Border Grid.Column="0"
                    Width="130"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="0,0,1,0"
                    Padding="10,8">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="6">

                        <TextBlock Classes="panel-section-label"
                                   Text="SELECT" />

                        <Button x:Name="SelectButton"
                                Classes="tool-button"
                                Content="Select"
                                Click="Select_Click" />

                        <Separator Margin="0,8" />

                        <TextBlock Classes="panel-section-label"
                                   Text="DRAW" />

                        <Button x:Name="LineButton"
                                Classes="tool-button"
                                Content="Line"
                                Click="Line_Click" />

                        <Button x:Name="RectangleButton"
                                Classes="tool-button"
                                Content="Rectangle"
                                Click="Rectangle_Click" />

                        <Button x:Name="CircleButton"
                                Classes="tool-button"
                                Content="Circle"
                                Click="Circle_Click" />

                        <Button x:Name="PolylineButton"
                                Classes="tool-button"
                                Content="Polyline"
                                Click="Polyline_Click" />

                        <Separator Margin="0,8" />

                        <TextBlock Classes="panel-section-label"
                                   Text="EDIT" />

                        <Button x:Name="MoveButton"
                                Classes="tool-button"
                                Content="Move"
                                Click="Move_Click" />

                        <Button x:Name="CopyButton"
                                Classes="tool-button"
                                Content="Copy"
                                Click="Copy_Click" />

                        <Button x:Name="RotateButton"
                                Classes="tool-button"
                                Content="Rotate"
                                Click="Rotate_Click" />

                        <Button x:Name="ScaleButton"
                                Classes="tool-button"
                                Content="Scale"
                                Click="Scale_Click" />

                        <Button x:Name="AlignButton"
                                Classes="tool-button"
                                Content="Align"
                                Click="Align_Click" />

                        <Separator Margin="0,8" />

                        <Button x:Name="BreakAtPointButton"
                                Classes="tool-button"
                                Content="Break Pt"
                                Click="BreakAtPoint_Click" />

                        <Button x:Name="BreakBetweenPointsButton"
                                Classes="tool-button"
                                Content="Break Seg"
                                Click="BreakBetweenPoints_Click" />

                        <Button x:Name="ExtendButton"
                                Classes="tool-button"
                                Content="Extend"
                                Click="Extend_Click" />

                        <Button x:Name="TrimButton"
                                Classes="tool-button"
                                Content="Trim"
                                Click="Trim_Click" />

                        <Button Classes="tool-button"
                                Content="Delete"
                                Click="Delete_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CAD Canvas host: clips drawing so grid/crosshair cannot overlap UI chrome. -->
            <Border Grid.Column="1"
                    Background="#1E1E1E"
                    ClipToBounds="True">

                <controls:CadCanvas x:Name="CadCanvas"
                                    ClipToBounds="True"
                                    Workspace="{Binding Workspace}"
                                    WorkspaceChanged="CadCanvas_WorkspaceChanged" />
            </Border>

            <!-- Right property panel -->
            <Border Grid.Column="2"
                    Classes="property-panel"
                    Width="300"
                    IsVisible="{Binding IsPropertyPanelVisible}">

                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Background="#2D2D30"
                            BorderBrush="#3A3A3A"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Classes="property-panel-title"
                                       Text="{Binding PropertyPanel.Title}" />

                            <Button Grid.Column="1"
                                    Classes="global-button"
                                    Content="×"
                                    MinWidth="34"
                                    Padding="6,2"
                                    Click="PropertyPanelClose_Click" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Border Padding="12,4,12,12">
                            <ItemsControl ItemsSource="{Binding PropertyPanel.Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="props:PropertySectionViewModel">
                                    <StackPanel>
                                        <TextBlock Classes="property-section-title"
                                                   Text="{Binding Title}" />

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="props:PropertyRowViewModel">
                                                    <Grid ColumnDefinitions="105,*"
                                                          ColumnSpacing="8"
                                                          Margin="0,2">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="property-name"
                                                                   Text="{Binding Name}" />

                                                        <TextBlock Grid.Column="1"
                                                                   Classes="property-value"
                                                                   Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Snap bar -->
        <Border Grid.Row="3"
                Background="#252526"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="8,6">

            <StackPanel Orientation="Horizontal"
                        Spacing="10">

                <TextBlock Text="Snap:"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           FontWeight="Bold" />

                <CheckBox x:Name="SnapEndpointCheckBox"
                          Classes="snap-check"
                          Content="Endpoint"
                          IsChecked="True"
                          Click="SnapEndpoint_Changed" />

                <CheckBox x:Name="SnapMidpointCheckBox"
                          Classes="snap-check"
                          Content="Midpoint"
                          IsChecked="True"
                          Click="SnapMidpoint_Changed" />

                <CheckBox x:Name="SnapCenterCheckBox"
                          Classes="snap-check"
                          Content="Center"
                          IsChecked="True"
                          Click="SnapCenter_Changed" />

                <CheckBox x:Name="SnapQuadrantCheckBox"
                          Classes="snap-check"
                          Content="Quadrant"
                          IsChecked="True"
                          Click="SnapQuadrant_Changed" />

                <Separator Margin="4,0" />

                <CheckBox x:Name="SnapIntersectionCheckBox"
                          Classes="snap-check"
                          Content="Intersection"
                          IsChecked="True"
                          Click="SnapIntersection_Changed" />

                <CheckBox x:Name="SnapPerpendicularCheckBox"
                          Classes="snap-check"
                          Content="Perpendicular"
                          IsChecked="True"
                          Click="SnapPerpendicular_Changed" />

                <CheckBox x:Name="SnapTangentCheckBox"
                          Classes="snap-check"
                          Content="Tangent"
                          IsChecked="True"
                          Click="SnapTangent_Changed" />

                <Separator Margin="4,0" />

                <CheckBox x:Name="SnapGridCheckBox"
                          Classes="snap-check"
                          Content="Grid"
                          IsChecked="True"
                          Click="SnapGrid_Changed" />

                <Separator Margin="4,0" />

                <CheckBox x:Name="OrthoCheckBox"
                          Classes="snap-check"
                          Content="Ortho"
                          IsChecked="False"
                          Click="Ortho_Changed" />
            </StackPanel>
        </Border>

        <!-- Command line -->
        <Border Grid.Row="4"
                Background="#1B1B1B"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="8,6">

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">

                <TextBlock Grid.Column="0"
                           Text="{Binding CommandPromptText}"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12" />

                <TextBox Grid.Column="1"
                         x:Name="CommandInputTextBox"
                         Background="#111111"
                         Foreground="#FFFFFF"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="6,3"
                         PlaceholderText="100,50   |   @50,0   |   5"
                         KeyDown="CommandInputTextBox_KeyDown" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5"
                Background="#111111"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="8,5"
                MinHeight="28">

            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding StatusText}"
                       Foreground="#E0E0E0"
                       FontFamily="Consolas"
                       FontSize="12"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
