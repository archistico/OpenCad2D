<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCad2D.App.Controls"
        xmlns:vm="clr-namespace:OpenCad2D.App.ViewModels"
        x:Class="OpenCad2D.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OpenCad2D"
        Width="1100"
        Height="750"
        Background="#1E1E1E">

	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>

	<DockPanel>

		<Border DockPanel.Dock="Top"
                Background="#252526"
                Padding="8">

			<StackPanel Orientation="Horizontal"
                        Spacing="8">

				<Button Content="Select"
                        Click="Select_Click" />

				<Button Content="Line"
                        Click="Line_Click" />

				<Button Content="Rectangle"
                        Click="Rectangle_Click" />

				<Button Content="Move"
                        Click="Move_Click" />

				<Button Content="Copy"
                        Click="Copy_Click" />

				<Button Content="Delete"
                        Click="Delete_Click" />

				<Separator />

				<Button Content="Undo"
                        Click="Undo_Click" />

				<Button Content="Redo"
                        Click="Redo_Click" />

				<TextBlock Text="Ctrl+Z / Ctrl+Y / Canc / Esc"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />

			</StackPanel>
		</Border>

		<controls:CadCanvas Workspace="{Binding Workspace}" />

	</DockPanel>
</Window>