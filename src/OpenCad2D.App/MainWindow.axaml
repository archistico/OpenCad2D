<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:OpenCad2D.App.Controls"
        xmlns:vm="clr-namespace:OpenCad2D.App.ViewModels"
        xmlns:props="clr-namespace:OpenCad2D.App.ViewModels.Properties"
        x:Class="OpenCad2D.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OpenCad2D"
        Icon="/Assets/app-icon.ico"
        Width="1600"
        Height="960"
        WindowState="Maximized"
        Background="#1E1E1E"
        KeyDown="Window_KeyDown"
        TextInput="Window_TextInput">

    <Window.Styles>
        <Style Selector="Button.tool-button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Width" Value="110" />
        </Style>

        <Style Selector="Button.tool-button.active-tool">
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33A9FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Button.global-button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="58" />
        </Style>

        <Style Selector="Grid.icon-button-content">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Path.icon-button-path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="#DDDDDD" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.active-tool Path.icon-button-path">
            <Setter Property="Stroke" Value="White" />
        </Style>

        <Style Selector="TextBlock.icon-button-text">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

        <Style Selector="TextBlock.active-command-label">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#0E639C" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.panel-section-label">
            <Setter Property="Foreground" Value="#9CDCFE" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,5,0,3" />
        </Style>

        <Style Selector="CheckBox.snap-check">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="CheckBox.layer-check">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="ComboBox.compact-combo">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="26" />
        </Style>


        <Style Selector="Border.property-panel">
            <Setter Property="Background" Value="#232323" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>

        <Style Selector="TextBlock.property-panel-title">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.property-section-title">
            <Setter Property="Foreground" Value="#9CDCFE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style Selector="TextBlock.property-name">
            <Setter Property="Foreground" Value="#AFAFAF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock.property-value">
            <Setter Property="Foreground" Value="#F0F0F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">


        <!-- File command bar: keep document commands isolated from tool layout. -->
        <Border Grid.Row="0"
                Background="#1B1B1B"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="7,5">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Button Classes="global-button"
                            ToolTip.Tip="About OpenCad2D"
                            Click="About_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAbout}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="About" />
                                </Grid>
                            </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="6">

                    <TextBlock Text="File:"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />

                    <Button Classes="global-button"
                            ToolTip.Tip="Create a new OpenCad2D document"
                            Click="New_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconNew}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="New" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Open an existing .opencad2d.json drawing"
                            Click="Open_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconOpen}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Open" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Import an ASCII DXF drawing into a new OpenCad2D document"
                            Click="ImportDxf_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconImportDXF}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Import DXF" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Save the current drawing"
                            Click="Save_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconSave}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Save" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Save the current drawing to a new file"
                            Click="SaveAs_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconSaveAs}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Save As" />
                                </Grid>
                            </Button>

                    <Separator Margin="5,0" />

                    <Button Classes="global-button"
                            ToolTip.Tip="Export the drawing as SVG"
                            Click="ExportSvg_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconExportSVG}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Export SVG" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Export the drawing as DXF"
                            Click="ExportDxf_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconExportDXF}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Export DXF" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Export a print-friendly PDF drawing"
                            Click="ExportPdf_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconExportPDF}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Export PDF" />
                                </Grid>
                            </Button>

                    <Separator Margin="5,0" />

                    <TextBlock Text="{Binding FileStatusText}"
                               Foreground="#DCDCAA"
                               VerticalAlignment="Center"
                               FontFamily="Consolas" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top bar: session/global state -->
        <Border Grid.Row="1"
                Background="#252526"
                BorderBrush="#3A3A3A"
                BorderThickness="0,0,0,1"
                Padding="7,5">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="6">

                    <TextBlock Text="Layer:"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />

                    <Button Classes="global-button"
                            ToolTip.Tip="Assign selected entities to the current layer"
                            Click="AssignCurrentLayer_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAssign}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Assign" />
                                </Grid>
                            </Button>

                    <ComboBox x:Name="LayerComboBox"
                              Classes="compact-combo"
                              Width="142"
                              SelectionChanged="LayerComboBox_SelectionChanged" />

                    <CheckBox x:Name="LayerVisibleCheckBox"
                              Classes="layer-check"
                              Content="Visible"
                              IsChecked="True"
                              IsEnabled="False"
                              Click="LayerVisibleCheckBox_Click" />

                    <CheckBox x:Name="LayerLockedCheckBox"
                              Classes="layer-check"
                              Content="Locked"
                              IsChecked="False"
                              IsEnabled="False"
                              Click="LayerLockedCheckBox_Click" />

                    <Button Classes="global-button"
                            ToolTip.Tip="Open the Layer Manager"
                            Click="Layers_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconLayers}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Layers..." />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Open the Line Format Manager"
                            Click="LineFormats_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconLineFormats}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Line formats..." />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Open the Text Format Manager"
                            Click="TextFormats_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconTextFormats}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Text formats..." />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Configure grid display and spacing"
                            Click="Grid_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconGrid}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Grid..." />
                                </Grid>
                            </Button>

                    <Separator Margin="5,0" />

                    <TextBlock Text="Polar:"
                               Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Margin="0,0,2,0" />

                    <ComboBox x:Name="PolarTrackingComboBox"
                              Classes="compact-combo"
                              Width="80"
                              SelectionChanged="PolarTrackingComboBox_SelectionChanged" />

                    <Separator Margin="5,0" />

                    <Button Classes="global-button"
                            ToolTip.Tip="Undo the last operation"
                            Click="Undo_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconUndo}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Undo" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Redo the last undone operation"
                            Click="Redo_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconRedo}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Redo" />
                                </Grid>
                            </Button>

                    <Button Classes="global-button"
                            ToolTip.Tip="Zoom to show the full drawing extents"
                            Click="ZoomExtents_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconExtents}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Extents" />
                                </Grid>
                            </Button>

                    <Button x:Name="PropertiesButton"
                            Classes="global-button"
                            ToolTip.Tip="Show or hide the selection property panel"
                            Click="Properties_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconProps}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Props" />
                                </Grid>
                            </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main work area -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ClipToBounds="True">

            <!-- Left tool panel -->
            <Border Grid.Column="0"
                    Width="248"
                    Background="#202020"
                    BorderBrush="#3A3A3A"
                    BorderThickness="0,0,1,0"
                    Padding="8,6">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="110,110"
                          ColumnSpacing="8">

                        <StackPanel Grid.Column="0"
                                    Spacing="4">

                            <TextBlock Classes="panel-section-label"
                                       Text="SELECT" />

                            <Button x:Name="SelectButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Select entities in the drawing"
                                    Click="Select_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconSelect}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Select" />
                                </Grid>
                            </Button>

                            <Button x:Name="SelectAllButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Select all visible and unlocked entities"
                                    Click="SelectAll_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconSelectAll}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Select All" />
                                </Grid>
                            </Button>

                            <Button x:Name="SelectLastButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Restore the last effective selection"
                                    Click="SelectLast_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconSelectLast}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Select Last" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="panel-section-label"
                                       Text="DRAW" />

                            <Button x:Name="PointButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a point entity"
                                    Click="Point_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconPoint}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Point" />
                                </Grid>
                            </Button>

                            <Button x:Name="TextButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Place a text entity"
                                    Click="Text_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconText}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Text" />
                                </Grid>
                            </Button>

                            <Button x:Name="MultilineTextButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Place a multiline text entity"
                                    Click="MultilineText_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconMText}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="MText" />
                                </Grid>
                            </Button>

                            <Button x:Name="LineButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a line from two points"
                                    Click="Line_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconLine}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Line" />
                                </Grid>
                            </Button>

                            <Button x:Name="RectangleButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a rectangle from two opposite corners"
                                    Click="Rectangle_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconRectangle}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Rectangle" />
                                </Grid>
                            </Button>

                            <Button x:Name="RectangleBySidesButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a rectangle by side dimensions"
                                    Click="RectangleBySides_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconRectSides}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Rect Sides" />
                                </Grid>
                            </Button>

                            <Button x:Name="CircleButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a circle by center and radius"
                                    Click="Circle_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconCircle}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Circle" />
                                </Grid>
                            </Button>

                            <Button x:Name="EllipseButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw an ellipse by center, major axis and minor radius"
                                    Click="Ellipse_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconEllipse}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Ellipse" />
                                </Grid>
                            </Button>

                            <Button x:Name="ArcButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw an arc by center/start/end"
                                    Click="Arc_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconArc}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Arc" />
                                </Grid>
                            </Button>

                            <Button x:Name="ArcThreePointsButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw an arc through three points"
                                    Click="ArcThreePoints_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconArc3P}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Arc 3P" />
                                </Grid>
                            </Button>

                            <Button x:Name="PolylineButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a polyline with multiple vertices"
                                    Click="Polyline_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconPolyline}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Polyline" />
                                </Grid>
                            </Button>

                            <Button x:Name="SplineButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a Bezier spline with control points"
                                    Click="Spline_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconSpline}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Spline" />
                                </Grid>
                            </Button>

                            <Button x:Name="PolygonButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Draw a regular polygon from side count, center and vertex"
                                    Click="Polygon_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconPolygon}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Polygon" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="panel-section-label"
                                       Text="DIMENSION" />

                            <Button x:Name="HorizontalDimensionButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Add a horizontal dimension"
                                    Click="HorizontalDimension_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconHorizontalDim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Horizontal Dim" />
                                </Grid>
                            </Button>

                            <Button x:Name="VerticalDimensionButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Add a vertical dimension"
                                    Click="VerticalDimension_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconVerticalDim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Vertical Dim" />
                                </Grid>
                            </Button>

                            <Button x:Name="AlignedDimensionButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Add an aligned dimension"
                                    Click="AlignedDimension_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAlignedDim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Aligned Dim" />
                                </Grid>
                            </Button>

                            <Button x:Name="RadiusDimensionButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Add a radius dimension"
                                    Click="RadiusDimension_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconRadiusDim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Radius Dim" />
                                </Grid>
                            </Button>

                            <Button x:Name="DiameterDimensionButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Add a diameter dimension"
                                    Click="DiameterDimension_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconDiameterDim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Diameter Dim" />
                                </Grid>
                            </Button>

                            <Button x:Name="AngularDimensionButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Add an angular dimension"
                                    Click="AngularDimension_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAngularDim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Angular Dim" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="panel-section-label"
                                       Text="MEASURE" />

                            <Button x:Name="MeasureDistanceButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Measure the distance between two points"
                                    Click="MeasureDistance_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconDistance}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Distance" />
                                </Grid>
                            </Button>

                            <Button x:Name="MeasureEntityButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Measure properties of a selected entity"
                                    Click="MeasureEntity_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconProps}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Entity" />
                                </Grid>
                            </Button>

                            <Button x:Name="MeasureAngleButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Measure an angle"
                                    Click="MeasureAngle_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAngle}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Angle" />
                                </Grid>
                            </Button>

                            <Button x:Name="MeasureAreaButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Measure a closed area"
                                    Click="MeasureArea_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconArea}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Area" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="4">

                            <TextBlock Classes="panel-section-label"
                                       Text="NAVIGATE" />

                            <Button x:Name="ZoomWindowButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Zoom to a rectangular window"
                                    Click="ZoomWindow_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconZoomWindow}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Zoom Window" />
                                </Grid>
                            </Button>

                            <Button x:Name="ZoomExtentsPanelButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Zoom to show the full drawing extents"
                                    Click="ZoomExtents_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconZoomExtents}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Zoom Extents" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="panel-section-label"
                                       Text="EDIT" />

                            <Button x:Name="MoveButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Move selected entities by base and destination points"
                                    Click="Move_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconMove}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Move" />
                                </Grid>
                            </Button>

                            <Button x:Name="CopyButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Copy selected entities by base and destination points"
                                    Click="Copy_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconCopy}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Copy" />
                                </Grid>
                            </Button>

                            <Button x:Name="RotateButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Rotate selected entities"
                                    Click="Rotate_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconRotate}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Rotate" />
                                </Grid>
                            </Button>

                            <Button x:Name="ScaleButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Scale selected entities"
                                    Click="Scale_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconScale}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Scale" />
                                </Grid>
                            </Button>

                            <Button x:Name="AlignButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Align selected entities using source and destination points"
                                    Click="Align_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAlign}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Align" />
                                </Grid>
                            </Button>

                            <Button x:Name="BreakAtPointButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Break an entity at a single point"
                                    Click="BreakAtPoint_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconBreakPt}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Break Pt" />
                                </Grid>
                            </Button>

                            <Button x:Name="BreakBetweenPointsButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Remove a segment between two break points"
                                    Click="BreakBetweenPoints_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconBreakSeg}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Break Seg" />
                                </Grid>
                            </Button>

                            <Button x:Name="ExtendButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Extend an entity to a boundary"
                                    Click="Extend_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconExtend}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Extend" />
                                </Grid>
                            </Button>

                            <Button x:Name="TrimButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Trim entities using cutting edges"
                                    Click="Trim_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconTrim}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Trim" />
                                </Grid>
                            </Button>

                            <Button x:Name="OffsetButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Create an offset copy of a line, circle or arc"
                                    Click="Offset_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconOffset}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Offset" />
                                </Grid>
                            </Button>

                            <Button x:Name="FilletButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Create a line-line fillet with the current radius"
                                    Click="Fillet_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconFillet}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Fillet" />
                                </Grid>
                            </Button>

                            <Button x:Name="MirrorButton"
                                    Classes="tool-button"
                                    ToolTip.Tip="Mirror selected entities across a two-point axis"
                                    Click="Mirror_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconMirror}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Mirror" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Delete the selected entities"
                                    Click="Delete_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconDelete}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Delete" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="panel-section-label"
                                       Text="ALIGN OBJECTS" />

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Align selected entities to the left edge of the selection bounds"
                                    Click="AlignLeft_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAlignLeft}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Align Left" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Align selected entities to the right edge of the selection bounds"
                                    Click="AlignRight_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAlignRight}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Align Right" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Align selected entities to the top edge of the selection bounds"
                                    Click="AlignTop_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAlignTop}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Align Top" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Align selected entities to the bottom edge of the selection bounds"
                                    Click="AlignBottom_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconAlignBottom}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Align Bottom" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Distribute selected entities horizontally by center, keeping first and last fixed"
                                    Click="DistributeHorizontal_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconDistributeH}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Distribute H" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Distribute selected entities vertically by center, keeping first and last fixed"
                                    Click="DistributeVertical_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconDistributeV}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Distribute V" />
                                </Grid>
                            </Button>

                            <TextBlock Classes="panel-section-label"
                                       Text="ORDER" />

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Bring selected entities to the top draw order"
                                    Click="BringToFront_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconToFront}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="To Front" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Send selected entities to the bottom draw order"
                                    Click="SendToBack_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconToBack}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="To Back" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Move selected entities one draw-order step up"
                                    Click="BringForward_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconForward}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Forward" />
                                </Grid>
                            </Button>

                            <Button Classes="tool-button"
                                    ToolTip.Tip="Move selected entities one draw-order step down"
                                    Click="SendBackward_Click" >
                                <Grid Classes="icon-button-content" ColumnDefinitions="16,*" ColumnSpacing="7">
                                    <Path Grid.Column="0"
                                          Classes="icon-button-path"
                                          Data="{StaticResource IconBackward}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="icon-button-text"
                                               Text="Backward" />
                                </Grid>
                            </Button>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- CAD Canvas host: clips drawing so grid/crosshair cannot overlap UI chrome. -->
            <Border Grid.Column="1"
                    Background="#1E1E1E"
                    ClipToBounds="True">

                <controls:CadCanvas x:Name="CadCanvas"
                                    ClipToBounds="True"
                                    Workspace="{Binding Workspace}"
                                    WorkspaceChanged="CadCanvas_WorkspaceChanged"
                                    RepeatLastCommandRequested="CadCanvas_RepeatLastCommandRequested" />
            </Border>

            <!-- Right property panel -->
            <Border Grid.Column="2"
                    Classes="property-panel"
                    Width="300"
                    IsVisible="{Binding IsPropertyPanelVisible}">

                <Grid RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Background="#2D2D30"
                            BorderBrush="#3A3A3A"
                            BorderThickness="0,0,0,1"
                            Padding="8,6">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Classes="property-panel-title"
                                       Text="{Binding PropertyPanel.Title}" />

                            <Button Grid.Column="1"
                                    Classes="global-button"
                                    Content="×"
                                    ToolTip.Tip="Close the property panel"
                                    MinWidth="34"
                                    Padding="5,1"
                                    Click="PropertyPanelClose_Click" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <Border Padding="12,4,12,12">
                            <ItemsControl ItemsSource="{Binding PropertyPanel.Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="props:PropertySectionViewModel">
                                    <StackPanel>
                                        <TextBlock Classes="property-section-title"
                                                   Text="{Binding Title}" />

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="props:PropertyRowViewModel">
                                                    <Grid ColumnDefinitions="95,*,Auto"
                                                          ColumnSpacing="8"
                                                          Margin="0,2">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="property-name"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Name}" />

                                                        <TextBlock Grid.Column="1"
                                                                   Classes="property-value"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding !IsEditable}"
                                                                   Text="{Binding Value}" />

                                                        <TextBox Grid.Column="1"
                                                                 MinHeight="26"
                                                                 Padding="5,2"
                                                                 IsVisible="{Binding IsEditable}"
                                                                 Text="{Binding EditableValue, Mode=TwoWay}" />

                                                        <Button Grid.Column="2"
                                                                Classes="global-button"
                                                                MinWidth="48"
                                                                Padding="6,2"
                                                                Content="Apply"
                                                                ToolTip.Tip="Apply this property value"
                                                                IsVisible="{Binding IsEditable}"
                                                                Command="{Binding ApplyCommand}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Snap bar -->
        <Border Grid.Row="3"
                Background="#252526"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="7,5">

            <StackPanel Orientation="Horizontal"
                        Spacing="10">

                <TextBlock Text="Snap:"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           FontWeight="Bold" />

                <CheckBox x:Name="SnapEndpointCheckBox"
                          Classes="snap-check"
                          Content="Endpoint"
                          IsChecked="True"
                          Click="SnapEndpoint_Changed" />

                <CheckBox x:Name="SnapMidpointCheckBox"
                          Classes="snap-check"
                          Content="Midpoint"
                          IsChecked="True"
                          Click="SnapMidpoint_Changed" />

                <CheckBox x:Name="SnapCenterCheckBox"
                          Classes="snap-check"
                          Content="Center"
                          IsChecked="True"
                          Click="SnapCenter_Changed" />

                <CheckBox x:Name="SnapQuadrantCheckBox"
                          Classes="snap-check"
                          Content="Quadrant"
                          IsChecked="True"
                          Click="SnapQuadrant_Changed" />

                <Separator Margin="4,0" />

                <CheckBox x:Name="SnapIntersectionCheckBox"
                          Classes="snap-check"
                          Content="Intersection"
                          IsChecked="True"
                          Click="SnapIntersection_Changed" />

                <CheckBox x:Name="SnapPerpendicularCheckBox"
                          Classes="snap-check"
                          Content="Perpendicular"
                          IsChecked="True"
                          Click="SnapPerpendicular_Changed" />

                <CheckBox x:Name="SnapTangentCheckBox"
                          Classes="snap-check"
                          Content="Tangent"
                          IsChecked="True"
                          Click="SnapTangent_Changed" />

                <Separator Margin="4,0" />

                <CheckBox x:Name="SnapGridCheckBox"
                          Classes="snap-check"
                          Content="Grid"
                          IsChecked="True"
                          Click="SnapGrid_Changed" />

                <Separator Margin="4,0" />

                <CheckBox x:Name="OrthoCheckBox"
                          Classes="snap-check"
                          Content="Ortho"
                          IsChecked="False"
                          Click="Ortho_Changed" />
            </StackPanel>
        </Border>

        <!-- Command line -->
        <Border Grid.Row="4"
                Background="#1B1B1B"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="7,5">

            <Grid ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="8">

                <TextBlock Grid.Column="0"
                           Classes="active-command-label"
                           Text="{Binding ActiveToolName}" />

                <TextBlock Grid.Column="1"
                           Text="{Binding CommandPromptText}"
                           Foreground="#CCCCCC"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12" />

                <TextBox Grid.Column="2"
                         x:Name="CommandInputTextBox"
                         Background="#111111"
                         Foreground="#FFFFFF"
                         BorderBrush="#555555"
                         BorderThickness="1"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="6,3"
                         PlaceholderText="{Binding CommandInputPlaceholderText}"
                         KeyDown="CommandInputTextBox_KeyDown" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5"
                Background="#252526"
                BorderBrush="#3A3A3A"
                BorderThickness="0,1,0,0"
                Padding="8,5"
                MinHeight="28">

            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding StatusText}"
                       Foreground="#E0E0E0"
                       FontFamily="Consolas"
                       FontSize="12"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
