<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layers="clr-namespace:OpenCad2D.App.ViewModels.Layers"
        x:Class="OpenCad2D.App.LayerManagerWindow"
        x:DataType="layers:LayerManagerWindowViewModel"
        Title="Layer Manager"
        Width="820"
        Height="460"
        MinWidth="720"
        MinHeight="380"
        Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="TextBlock.header-cell">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.cell-label">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.layer-input">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button.dialog-button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="12">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,10">
            <Button Classes="dialog-button"
                    Content="New"
                    Click="NewLayer_Click" />

            <Button Classes="dialog-button"
                    Content="Delete"
                    Click="DeleteLayer_Click" />

            <TextBlock Text="Current layer must remain visible and unlocked. Layer 0 cannot be renamed or deleted."
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Background="#202020">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        Padding="8,6">
                    <Grid ColumnDefinitions="70,190,80,80,105,90,70"
                          ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="header-cell" Text="Current" />
                        <TextBlock Grid.Column="1" Classes="header-cell" Text="Name" />
                        <TextBlock Grid.Column="2" Classes="header-cell" Text="Visible" />
                        <TextBlock Grid.Column="3" Classes="header-cell" Text="Locked" />
                        <TextBlock Grid.Column="4" Classes="header-cell" Text="Color" />
                        <TextBlock Grid.Column="5" Classes="header-cell" Text="Weight" />
                        <TextBlock Grid.Column="6" Classes="header-cell" Text="Entities" />
                    </Grid>
                </Border>

                <ListBox x:Name="LayerListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding Layers}"
                         SelectedItem="{Binding SelectedLayer}"
                         Background="#202020"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="layers:EditableLayerViewModel">
                            <Border Padding="8,5">
                                <Grid ColumnDefinitions="70,190,80,80,105,90,70"
                                      ColumnSpacing="8">
                                    <RadioButton Grid.Column="0"
                                                 IsChecked="{Binding IsCurrent, Mode=TwoWay}"
                                                 Click="CurrentLayerRadio_Click" />

                                    <TextBox Grid.Column="1"
                                             Classes="layer-input"
                                             Text="{Binding Name, Mode=TwoWay}"
                                             IsEnabled="{Binding CanRename}" />

                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              HorizontalAlignment="Center" />

                                    <CheckBox Grid.Column="3"
                                              IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                              HorizontalAlignment="Center" />

                                    <TextBox Grid.Column="4"
                                             Classes="layer-input"
                                             Text="{Binding ColorHex, Mode=TwoWay}" />

                                    <TextBox Grid.Column="5"
                                             Classes="layer-input"
                                             Text="{Binding LineWeightText, Mode=TwoWay}" />

                                    <TextBlock Grid.Column="6"
                                               Classes="cell-label"
                                               Text="{Binding EntityCount}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationMessage}"
                   Foreground="#F48771"
                   Margin="0,8,0,0"
                   IsVisible="{Binding HasValidationMessage}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Classes="dialog-button"
                    Content="Cancel"
                    Click="Cancel_Click" />

            <Button Classes="dialog-button"
                    Content="OK"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
