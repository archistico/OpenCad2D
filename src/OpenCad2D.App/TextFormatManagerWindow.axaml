<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:textFormats="clr-namespace:OpenCad2D.App.ViewModels.TextFormats"
        x:Class="OpenCad2D.App.TextFormatManagerWindow"
        x:DataType="textFormats:TextFormatManagerWindowViewModel"
        Title="Text Format Manager"
        Icon="/Assets/app-icon.ico"
        Width="1080"
        Height="520"
        MinWidth="940"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="TextBlock.header-cell">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox.format-input">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="ComboBox.format-combo">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Button.dialog-button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="74" />
        </Style>

        <Style Selector="TextBlock.cell-label">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="10">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,0,0,8">
            <Button Classes="dialog-button"
                    Content="Add"
                    Click="AddFormat_Click" />

            <Button Classes="dialog-button"
                    Content="Delete"
                    IsEnabled="{Binding CanDeleteSelectedFormat}"
                    Click="DeleteFormat_Click" />

            <TextBlock Text="Built-in text formats can be renamed and edited, but not deleted. Heights are drawing units."
                       Foreground="#AAAAAA"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Background="#202020">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="#2D2D30"
                        Padding="7,5">
                    <Grid ColumnDefinitions="78,175,145,90,110,70,70,190,95"
                          ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Classes="header-cell" Text="Color" />
                        <TextBlock Grid.Column="1" Classes="header-cell" Text="Name" />
                        <TextBlock Grid.Column="2" Classes="header-cell" Text="Font" />
                        <TextBlock Grid.Column="3" Classes="header-cell" Text="Height" />
                        <TextBlock Grid.Column="4" Classes="header-cell" Text="Color hex" />
                        <TextBlock Grid.Column="5" Classes="header-cell" Text="Bold" />
                        <TextBlock Grid.Column="6" Classes="header-cell" Text="Italic" />
                        <TextBlock Grid.Column="7" Classes="header-cell" Text="Preview" />
                        <TextBlock Grid.Column="8" Classes="header-cell" Text="Type" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Formats}"
                         SelectedItem="{Binding SelectedFormat}"
                         Background="#202020"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="textFormats:EditableTextFormatViewModel">
                            <Border Padding="7,4">
                                <Grid ColumnDefinitions="78,175,145,90,110,70,70,190,95"
                                      ColumnSpacing="6">
                                    <ColorPicker Grid.Column="0"
                                                 Width="54"
                                                 Height="26"
                                                 Color="{Binding Color, Mode=TwoWay}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center" />

                                    <TextBox Grid.Column="1"
                                             Classes="format-input"
                                             Text="{Binding Name, Mode=TwoWay}" />

                                    <ComboBox Grid.Column="2"
                                              Classes="format-combo"
                                              ItemsSource="{Binding CommonFontFamilies}"
                                              SelectedItem="{Binding FontFamily, Mode=TwoWay}" />

                                    <TextBox Grid.Column="3"
                                             Classes="format-input"
                                             Text="{Binding HeightText, Mode=TwoWay}" />

                                    <TextBox Grid.Column="4"
                                             Classes="format-input"
                                             Text="{Binding ColorHex, Mode=TwoWay}" />

                                    <CheckBox Grid.Column="5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsBold, Mode=TwoWay}" />

                                    <CheckBox Grid.Column="6"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsItalic, Mode=TwoWay}" />

                                    <TextBlock Grid.Column="7"
                                               Classes="cell-label"
                                               Text="{Binding PreviewText}"
                                               Foreground="{Binding ColorBrush}"
                                               FontFamily="{Binding PreviewFontFamily}"
                                               FontSize="{Binding PreviewFontSize}"
                                               FontWeight="{Binding PreviewFontWeight}"
                                               FontStyle="{Binding PreviewFontStyle}" />

                                    <TextBlock Grid.Column="8"
                                               Classes="cell-label"
                                               Text="{Binding BuiltInText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationMessage}"
                   Foreground="#F48771"
                   Margin="0,8,0,0"
                   IsVisible="{Binding HasValidationMessage}" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6"
                    Margin="0,12,0,0">
            <Button Classes="dialog-button"
                    Content="Cancel"
                    Click="Cancel_Click" />

            <Button Classes="dialog-button"
                    Content="OK"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
